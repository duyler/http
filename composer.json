{
    "name": "duyler/http",
    "type": "library",
    "description": "Duyler http handler",
    "license": "MIT",
    "keywords": [
        "roadrunner",
        "http",
        "server"
    ],
    "authors": [
        {
            "name": "Mikhail Ilinsky",
            "email": "mail@milinsky.ru"
        }
    ],
    "support": {
        "docs": "https://duyler.org/en/docs/http/"
    },
    "require": {
        "php": "^8.3",
        "duyler/config": "dev-main",
        "duyler/router": "dev-main",
        "duyler/event-bus": "dev-main",
        "duyler/builder": "dev-main",
        "httpsoft/http-server-request": "^1.1",
        "httpsoft/http-response": "^1.1",
        "spiral/roadrunner-http": "^3.5",
        "duyler/twig-wrapper": "dev-main",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "friendsofphp/php-cs-fixer": "^3.30",
        "vimeo/psalm": "^6.12",
        "rector/rector": "^2.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Duyler\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Duyler\\Http\\Test\\": ["tests/"]
        }
    }
}
